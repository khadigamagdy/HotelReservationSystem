@model HotelReservationSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="manager-dashboard-page">

    <!-- Dashboard Header -->
    <div class="manager-dashboard-header">

        <div class="manager-dashboard-heading">

            <span class="manager-dashboard-label">
                MANAGEMENT OVERVIEW
            </span>

            <h1>
                Manager Dashboard
            </h1>

            <p>
                Monitor rooms, reservations, payments and
                overall hotel performance from one place.
            </p>

        </div>

        <div class="manager-dashboard-icon">
            <i class="bi bi-speedometer2"></i>
        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4">

        <!-- Total Rooms -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Total Rooms
                    </span>

                    <div class="manager-stat-icon stat-blue">
                        <i class="bi bi-door-open"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.TotalRooms
                </div>

                <span class="manager-stat-description">
                    Registered hotel rooms
                </span>

            </div>

        </div>


        <!-- Available Rooms -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Available Rooms
                    </span>

                    <div class="manager-stat-icon stat-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.AvailableRooms
                </div>

                <span class="manager-stat-description">
                    Ready for new guests
                </span>

            </div>

        </div>


        <!-- Occupied Rooms -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Occupied Rooms
                    </span>

                    <div class="manager-stat-icon stat-red">
                        <i class="bi bi-person-fill"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.OccupiedRooms
                </div>

                <span class="manager-stat-description">
                    Currently occupied
                </span>

            </div>

        </div>


        <!-- Maintenance -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Maintenance
                    </span>

                    <div class="manager-stat-icon stat-orange">
                        <i class="bi bi-tools"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.MaintenanceRooms
                </div>

                <span class="manager-stat-description">
                    Rooms under maintenance
                </span>

            </div>

        </div>


        <!-- Total Reservations -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Total Reservations
                    </span>

                    <div class="manager-stat-icon stat-purple">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.TotalReservations
                </div>

                <span class="manager-stat-description">
                    Hotel bookings
                </span>

            </div>

        </div>


        <!-- Checked-In Guests -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Checked-In Guests
                    </span>

                    <div class="manager-stat-icon stat-blue">
                        <i class="bi bi-person-check"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.CheckedInGuests
                </div>

                <span class="manager-stat-description">
                    Guests currently staying
                </span>

            </div>

        </div>


        <!-- Pending Payments -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Pending Payments
                    </span>

                    <div class="manager-stat-icon stat-yellow">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

                <div class="manager-stat-value">
                    @Model.PendingPayments
                </div>

                <span class="manager-stat-description">
                    Payments awaiting completion
                </span>

            </div>

        </div>


        <!-- Total Revenue -->
        <div class="col-md-6 col-xl-3">

            <div class="manager-stat-card revenue-card">

                <div class="manager-stat-top">

                    <span class="manager-stat-label">
                        Total Revenue
                    </span>

                    <div class="manager-stat-icon stat-green">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

                <div class="manager-stat-value revenue-value">
                    @Model.TotalRevenue.ToString("N2")
                    <small>EGP</small>
                </div>

                <span class="manager-stat-description">
                    Total recorded revenue
                </span>

            </div>

        </div>

    </div>


    <!-- Reports -->
    <div class="manager-reports-section">

        <div class="manager-reports-header">

            <div class="manager-reports-title">

                <div class="manager-reports-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <div>

                    <span class="manager-reports-label">
                        ANALYTICS
                    </span>

                    <h2>
                        Reports
                    </h2>

                    <p>
                        Access detailed hotel performance reports.
                    </p>

                </div>

            </div>

        </div>


        <div class="row g-3">

            <!-- Reservations Report -->
            <div class="col-md-6 col-xl-3">

                <a asp-controller="Reports"
                   asp-action="Reservations"
                   class="manager-report-link">

                    <div class="manager-report-link-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                    <div class="manager-report-link-content">

                        <strong>
                            Reservations Report
                        </strong>

                        <span>
                            View booking details
                        </span>

                    </div>

                    <i class="bi bi-arrow-right manager-report-arrow"></i>

                </a>

            </div>


            <!-- Payments Report -->
            <div class="col-md-6 col-xl-3">

                <a asp-controller="Reports"
                   asp-action="Payments"
                   class="manager-report-link">

                    <div class="manager-report-link-icon">
                        <i class="bi bi-credit-card"></i>
                    </div>

                    <div class="manager-report-link-content">

                        <strong>
                            Payments Report
                        </strong>

                        <span>
                            Review payment activity
                        </span>

                    </div>

                    <i class="bi bi-arrow-right manager-report-arrow"></i>

                </a>

            </div>


            <!-- Rooms Report -->
            <div class="col-md-6 col-xl-3">

                <a asp-controller="Reports"
                   asp-action="Rooms"
                   class="manager-report-link">

                    <div class="manager-report-link-icon">
                        <i class="bi bi-door-open"></i>
                    </div>

                    <div class="manager-report-link-content">

                        <strong>
                            Rooms Report
                        </strong>

                        <span>
                            Monitor room status
                        </span>

                    </div>

                    <i class="bi bi-arrow-right manager-report-arrow"></i>

                </a>

            </div>


            <!-- Revenue Report -->
            <div class="col-md-6 col-xl-3">

                <a asp-controller="Reports"
                   asp-action="Revenue"
                   class="manager-report-link">

                    <div class="manager-report-link-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <div class="manager-report-link-content">

                        <strong>
                            Revenue Report
                        </strong>

                        <span>
                            Analyze hotel revenue
                        </span>

                    </div>

                    <i class="bi bi-arrow-right manager-report-arrow"></i>

                </a>

            </div>

        </div>

    </div>

</div>