@model HotelReservationSystem.Models.Entities.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="room-delete-page">

    <div class="room-delete-card">

        <!-- Header -->
        <div class="room-delete-header">

            <div class="room-delete-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <span class="room-delete-label">
                ROOM MANAGEMENT
            </span>

            <h1>
                Delete Room
            </h1>

            <p>
                Are you sure you want to delete this room?
                Please review the room information before continuing.
            </p>

        </div>

        <!-- Warning -->
        <div class="room-delete-warning">

            <div class="room-delete-warning-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <strong>
                    Warning
                </strong>

                <p>
                    This action cannot be undone.
                    Make sure you are deleting the correct room.
                </p>
            </div>

        </div>

        <!-- Room Details -->
        <div class="room-delete-details">

            <div class="room-delete-detail">

                <div class="room-delete-detail-icon">
                    <i class="bi bi-door-open"></i>
                </div>

                <div>
                    <span>
                        Room Number
                    </span>

                    <strong>
                        @Html.DisplayFor(model => model.RoomNumber)
                    </strong>
                </div>

            </div>

            <div class="room-delete-detail">

                <div class="room-delete-detail-icon">
                    <i class="bi bi-activity"></i>
                </div>

                <div>

                    <span>
                        Current Status
                    </span>

                    <strong class="room-delete-status status-@Model.Status">

                        @if (Model.Status == HotelReservationSystem.Enums.RoomStatus.Available)
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        else if (Model.Status == HotelReservationSystem.Enums.RoomStatus.Occupied)
                        {
                            <i class="bi bi-person-fill"></i>
                        }
                        else if (Model.Status == HotelReservationSystem.Enums.RoomStatus.Maintenance)
                        {
                            <i class="bi bi-tools"></i>
                        }

                        @Html.DisplayFor(model => model.Status)

                    </strong>

                </div>

            </div>

        </div>

        <!-- Actions -->
        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="room-delete-actions">

                <button type="submit"
                        class="room-delete-confirm-btn">

                    <i class="bi bi-trash3"></i>

                    Delete Room

                </button>

                <a asp-action="Index"
                   class="room-delete-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>