@model HotelReservationSystem.ViewModels.RoomEditViewModel

@{
    ViewData["Title"] = "Edit Room";
}

<div class="room-edit-page">

    <div class="room-edit-card">

        <!-- Header -->
        <div class="room-edit-header">

            <div class="room-edit-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <span class="room-edit-label">
                ROOM MANAGEMENT
            </span>

            <h1>
                Edit Room
            </h1>

            <p>
                Update the room information, status, type
                and available amenities.
            </p>

        </div>


        <!-- Form -->
        <form asp-action="Edit"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="room-edit-validation">
            </div>

            <input type="hidden"
                   asp-for="Id" />


            <!-- Room Information -->
            <div class="room-edit-section">

                <div class="room-edit-section-title">

                    <div class="room-edit-section-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>

                    <div>

                        <span>
                            ROOM INFORMATION
                        </span>

                        <h2>
                            Basic Details
                        </h2>

                    </div>

                </div>


                <div class="row g-4">

                    <!-- Room Number -->
                    <div class="col-md-6">

                        <div class="room-edit-form-group">

                            <label asp-for="RoomNumber">
                                Room Number
                            </label>

                            <div class="room-edit-input-wrapper">

                                <i class="bi bi-door-open"></i>

                                <input asp-for="RoomNumber"
                                       class="room-edit-input"
                                       placeholder="Enter room number" />

                            </div>

                            <span asp-validation-for="RoomNumber"
                                  class="room-edit-field-error">
                            </span>

                        </div>

                    </div>


                    <!-- Floor -->
                    <div class="col-md-6">

                        <div class="room-edit-form-group">

                            <label asp-for="FloorNumber">
                                Floor Number
                            </label>

                            <div class="room-edit-input-wrapper">

                                <i class="bi bi-layers"></i>

                                <input asp-for="FloorNumber"
                                       class="room-edit-input"
                                       type="number"
                                       placeholder="Enter floor number" />

                            </div>

                            <span asp-validation-for="FloorNumber"
                                  class="room-edit-field-error">
                            </span>

                        </div>

                    </div>


                    <!-- Room Type -->
                    <div class="col-md-6">

                        <div class="room-edit-form-group">

                            <label asp-for="RoomTypeId">
                                Room Type
                            </label>

                            <div class="room-edit-input-wrapper">

                                <i class="bi bi-house-door"></i>

                                <select asp-for="RoomTypeId"
                                        class="room-edit-select">

                                    <option value="">
                                        -- Select Room Type --
                                    </option>

                                    @foreach (var type in Model.RoomTypes)
                                    {
                                        <option value="@type.Id">
                                            @type.Name
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="RoomTypeId"
                                  class="room-edit-field-error">
                            </span>

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6">

                        <div class="room-edit-form-group">

                            <label asp-for="Status">
                                Room Status
                            </label>

                            <div class="room-edit-input-wrapper">

                                <i class="bi bi-activity"></i>

                                <select asp-for="Status"
                                        class="room-edit-select">

                                    @foreach (var status in Enum.GetValues<HotelReservationSystem.Enums.RoomStatus>())
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="Status"
                                  class="room-edit-field-error">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Amenities -->
            <div class="room-edit-section">

                <div class="room-edit-section-title">

                    <div class="room-edit-section-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>

                        <span>
                            ROOM FEATURES
                        </span>

                        <h2>
                            Amenities
                        </h2>

                        <p>
                            Select the amenities available in this room.
                        </p>

                    </div>

                </div>


                @if (Model.Amenities != null && Model.Amenities.Any())
                {
                    <div class="room-edit-amenities-grid">

                        @foreach (var amenity in Model.Amenities)
                        {
                            <label class="room-edit-amenity-option">

                                <input type="checkbox"
                                       name="AmenityIds"
                                       value="@amenity.Id"
                                @(Model.AmenityIds.Contains(amenity.Id)
                                    ? "checked"
                                    : "") />

                                <span class="room-edit-amenity-check">
                                    <i class="bi bi-check-lg"></i>
                                </span>

                                <span class="room-edit-amenity-icon">
                                    <i class="bi bi-stars"></i>
                                </span>

                                <span class="room-edit-amenity-name">
                                    @amenity.Name
                                </span>

                            </label>
                        }

                    </div>
                }
                else
                {
                    <div class="room-edit-no-amenities">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            No amenities have been added yet.
                        </span>

                    </div>
                }

            </div>


            <!-- Actions -->
            <div class="room-edit-actions">

                <button type="submit"
                        class="room-edit-save-btn">

                    <i class="bi bi-check-lg"></i>

                    Save Changes

                </button>


                <a asp-action="Index"
                   class="room-edit-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}