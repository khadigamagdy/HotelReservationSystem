@model HotelReservationSystem.Models.Entities.Room

@{
    ViewData["Title"] = "Room Details";
}

<h1>Room Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">Room Number</dt>
    <dd class="col-sm-9">@Model.RoomNumber</dd>

    <dt class="col-sm-3">Floor</dt>
    <dd class="col-sm-9">@Model.FloorNumber</dd>

    <dt class="col-sm-3">Room Type</dt>
    <dd class="col-sm-9">
        @(Model.RoomType?.Name ?? "N/A")
    </dd>

    <dt class="col-sm-3">Price Per Night</dt>
    <dd class="col-sm-9">
        @(Model.RoomType?.BasePricePerNight.ToString("0.00") ?? "N/A") EGP
    </dd>

    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">
        @(Model.RoomType?.Capacity.ToString() ?? "N/A")
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Amenities</dt>
    <dd class="col-sm-9">

        @if (Model.RoomAmenities != null &&
             Model.RoomAmenities.Any())
        {
            foreach (var roomAmenity in Model.RoomAmenities)
            {
                <span class="badge bg-secondary me-1">
                    @roomAmenity.Amenity.Name
                </span>
            }
        }
        else
        {
            <span>No amenities</span>
        }

    </dd>

</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>
