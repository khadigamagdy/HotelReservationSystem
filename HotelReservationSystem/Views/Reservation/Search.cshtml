@model HotelReservationSystem.ViewModels.SearchViewModel

@{
    ViewData["Title"] = "Search Rooms";
}

<div class="search-rooms-page">

    <div class="search-rooms-card">

        <!-- Header -->
        <div class="search-rooms-header">

            <div class="search-rooms-icon">
                <i class="bi bi-search"></i>
            </div>

            <span class="search-rooms-label">
                LUXORA HOTEL
            </span>

            <h1>
                Find Your Perfect Room
            </h1>

            <p>
                Select your check-in and check-out dates
                to discover the rooms available for your stay.
            </p>

        </div>


        <!-- Search Form -->
        <form asp-controller="Reservation"
              asp-action="Search"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="search-rooms-validation">
            </div>


            <div class="search-rooms-form">

                <!-- Check-In -->
                <div class="search-date-group">

                    <label asp-for="CheckInDate">
                        Check-In Date
                    </label>

                    <div class="search-date-input">

                        <i class="bi bi-calendar-check"></i>

                        <input asp-for="CheckInDate"
                               class="search-date-field" />

                    </div>

                    <span asp-validation-for="CheckInDate"
                          class="search-field-error">
                    </span>

                </div>


                <!-- Check-Out -->
                <div class="search-date-group">

                    <label asp-for="CheckOutDate">
                        Check-Out Date
                    </label>

                    <div class="search-date-input">

                        <i class="bi bi-calendar-x"></i>

                        <input asp-for="CheckOutDate"
                               class="search-date-field" />

                    </div>

                    <span asp-validation-for="CheckOutDate"
                          class="search-field-error">
                    </span>

                </div>

            </div>


            <!-- Information -->
            <div class="search-rooms-info">

                <div class="search-info-icon">
                    <i class="bi bi-info-circle"></i>
                </div>

                <div>

                    <strong>
                        Choose Your Stay Dates
                    </strong>

                    <p>
                        We'll show you the rooms available
                        for the dates you select.
                    </p>

                </div>

            </div>


            <!-- Submit -->
            <button type="submit"
                    class="search-rooms-btn">

                <i class="bi bi-search"></i>

                Search Available Rooms

                <i class="bi bi-arrow-right"></i>

            </button>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}