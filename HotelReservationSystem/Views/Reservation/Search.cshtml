@model HotelReservationSystem.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Search Rooms";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Search Available Rooms</h3>

                <form asp-controller="Reservation" asp-action="Search" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CheckInDate" class="form-label"></label>
                        <input asp-for="CheckInDate" class="form-control" />
                        <span asp-validation-for="CheckInDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CheckOutDate" class="form-label"></label>
                        <input asp-for="CheckOutDate" class="form-control" />
                        <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
