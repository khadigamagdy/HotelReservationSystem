@model HotelReservationSystem.Models.Entities.Reservation

@{
    ViewData["Title"] = "Cancel Reservation";
}

<div class="cancel-reservation-page">

    <div class="cancel-reservation-card">

        <div class="cancel-reservation-icon">
            <i class="bi bi-calendar-x"></i>
        </div>

        <span class="cancel-reservation-label">
            RESERVATION MANAGEMENT
        </span>

        <h1>
            Cancel Reservation
        </h1>

        <p class="cancel-reservation-subtitle">
            Are you sure you want to cancel your reservation?
            Please review the booking details before continuing.
        </p>


        <!-- Reservation Details -->
        <div class="cancel-reservation-details">

            <div class="cancel-detail-item">

                <div class="cancel-detail-icon">
                    <i class="bi bi-hash"></i>
                </div>

                <div>
                    <span>
                        Reservation
                    </span>

                    <strong>
                        #@Model.Id
                    </strong>
                </div>

            </div>


            <div class="cancel-detail-item">

                <div class="cancel-detail-icon">
                    <i class="bi bi-door-open"></i>
                </div>

                <div>
                    <span>
                        Room
                    </span>

                    <strong>
                        @Model.Room.RoomNumber
                    </strong>
                </div>

            </div>


            <div class="cancel-detail-item">

                <div class="cancel-detail-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <span>
                        Check-In
                    </span>

                    <strong>
                        @Model.CheckInDate.ToShortDateString()
                    </strong>
                </div>

            </div>


            <div class="cancel-detail-item">

                <div class="cancel-detail-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <div>
                    <span>
                        Check-Out
                    </span>

                    <strong>
                        @Model.CheckOutDate.ToShortDateString()
                    </strong>
                </div>

            </div>

        </div>


        <!-- Warning -->
        <div class="cancel-reservation-warning">

            <div class="cancel-warning-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>

                <strong>
                    Cancellation Notice
                </strong>

                <p>
                    Cancelling this reservation will change its status
                    and may affect room availability.
                </p>

            </div>

        </div>


        <!-- Actions -->
        <form asp-controller="Reservation"
              asp-action="Cancel"
              asp-route-id="@Model.Id"
              method="post">

            <div class="cancel-reservation-actions">

                <button type="submit"
                        class="cancel-confirm-btn">

                    <i class="bi bi-x-circle"></i>

                    Yes, Cancel Reservation

                </button>


                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="cancel-back-btn">

                    <i class="bi bi-arrow-left"></i>

                    No, Go Back

                </a>

            </div>

        </form>

    </div>

</div>