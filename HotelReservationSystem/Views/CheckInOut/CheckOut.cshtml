@model HotelReservationSystem.Models.Entities.Reservation

@{
    ViewData["Title"] = "Check-Out Guest";

    decimal totalPaid = ViewBag.TotalPaid ?? 0m;
    decimal remainingAmount = ViewBag.RemainingAmount ?? 0m;
}

<div class="checkout-page">

    <div class="checkout-card">

        <!-- Header -->
        <div class="checkout-header">

            <div class="checkout-icon">
                <i class="bi bi-box-arrow-right"></i>
            </div>

            <span class="checkout-label">
                FRONT DESK
            </span>

            <h1>Guest Check-Out</h1>

            <p>
                Review the reservation and payment details before
                completing the guest's check-out.
            </p>

        </div>


        <!-- Reservation Information -->
        <div class="checkout-section">

            <div class="checkout-section-title">

                <div class="checkout-section-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h3>Reservation Information</h3>

                    <span>
                        Guest and room details
                    </span>
                </div>

            </div>


            <div class="reservation-details-grid">

                <!-- Reservation ID -->
                <div class="reservation-detail">

                    <span>
                        Reservation ID
                    </span>

                    <strong>
                        #@Model.Id
                    </strong>

                </div>


                <!-- Guest -->
                <div class="reservation-detail">

                    <span>
                        Guest Name
                    </span>

                    <strong>
                        @Model.Guest?.User?.FullName
                    </strong>

                </div>


                <!-- Room -->
                <div class="reservation-detail">

                    <span>
                        Room Number
                    </span>

                    <strong>
                        @Model.Room?.RoomNumber
                    </strong>

                </div>


                <!-- Room Type -->
                <div class="reservation-detail">

                    <span>
                        Room Type
                    </span>

                    <strong>
                        @Model.Room?.RoomType?.Name
                    </strong>

                </div>


                <!-- Check-In -->
                <div class="reservation-detail">

                    <span>
                        Check-In Date
                    </span>

                    <strong>
                        @Model.CheckInDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>


                <!-- Check-Out -->
                <div class="reservation-detail">

                    <span>
                        Check-Out Date
                    </span>

                    <strong>
                        @Model.CheckOutDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>

            </div>

        </div>


        <!-- Payment Information -->
        <div class="checkout-section">

            <div class="checkout-section-title">

                <div class="checkout-section-icon">
                    <i class="bi bi-credit-card"></i>
                </div>

                <div>
                    <h3>Payment Information</h3>

                    <span>
                        Review the reservation payment status
                    </span>
                </div>

            </div>


            <div class="payment-summary-grid">

                <!-- Total Price -->
                <div class="payment-summary-item">

                    <span>
                        Total Price
                    </span>

                    <strong>
                        @Model.TotalPrice.ToString("N2") EGP
                    </strong>

                </div>


                <!-- Total Paid -->
                <div class="payment-summary-item">

                    <span>
                        Total Paid
                    </span>

                    <strong class="paid-value">
                        @totalPaid.ToString("N2") EGP
                    </strong>

                </div>


                <!-- Remaining -->
                <div class="payment-summary-item">

                    <span>
                        Remaining
                    </span>

                    <strong class="remaining-value">
                        @remainingAmount.ToString("N2") EGP
                    </strong>

                </div>

            </div>

        </div>


        <!-- Payment Status -->
        @if (remainingAmount > 0)
        {
            <div class="checkout-alert checkout-alert-danger">

                <div class="checkout-alert-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>

                <div>

                    <strong>
                        Payment Required
                    </strong>

                    <p>
                        The guest still has
                        <strong>
                            @remainingAmount.ToString("N2") EGP
                        </strong>
                        remaining.
                        Please record the remaining payment before
                        completing check-out.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="checkout-alert checkout-alert-success">

                <div class="checkout-alert-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>

                    <strong>
                        Payment Completed
                    </strong>

                    <p>
                        The reservation has been fully paid.
                        The guest can now be checked out.
                    </p>

                </div>

            </div>
        }


        <!-- Check-Out Confirmation -->
        @if (remainingAmount <= 0)
        {
            <div class="checkout-warning">

                <div class="checkout-warning-header">

                    <i class="bi bi-info-circle"></i>

                    <strong>
                        Check-Out Confirmation
                    </strong>

                </div>

                <ul>

                    <li>
                        Reservation will be marked as
                        <strong>Checked Out</strong>.
                    </li>

                    <li>
                        Room will be marked as
                        <strong>Available</strong>.
                    </li>

                    <li>
                        The receptionist who completed the
                        check-out will be recorded.
                    </li>

                </ul>

            </div>


            <!-- Actions -->
            <form asp-controller="CheckInOut"
                  asp-action="CheckOut"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="checkout-actions">

                    <button type="submit"
                            class="checkout-confirm-btn">

                        <i class="bi bi-check-circle"></i>

                        Confirm Check-Out

                    </button>

                    <a asp-controller="CheckInOut"
                       asp-action="Reservations"
                       class="checkout-cancel-btn">

                        <i class="bi bi-arrow-left"></i>

                        Cancel

                    </a>

                </div>

            </form>
        }
        else
        {
            <!-- Payment Required Actions -->
            <div class="checkout-payment-actions">

                <a asp-controller="Payments"
                   asp-action="Create"
                   asp-route-reservationId="@Model.Id"
                   class="checkout-payment-btn">

                    <i class="bi bi-credit-card"></i>

                    Add Payment

                </a>

                <a asp-controller="CheckInOut"
                   asp-action="Reservations"
                   class="checkout-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

            </div>
        }

    </div>

</div>