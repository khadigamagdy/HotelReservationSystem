@{
    ViewData["Title"] = "Check-Out Completed";
}

<div class="checkout-completed-page">

    <div class="checkout-completed-card">

        <!-- Success Icon -->
        <div class="completed-icon">
            <i class="bi bi-check-lg"></i>
        </div>


        <!-- Header -->
        <span class="completed-label">
            FRONT DESK
        </span>

        <h1>
            Check-Out Completed
        </h1>

        <p class="completed-subtitle">
            The guest has been successfully checked out
            and the reservation has been completed.
        </p>


        <!-- Success Message -->
        <div class="completed-success-box">

            <div class="completed-success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>
                    Successfully Checked Out
                </strong>

                <p>
                    The guest has been successfully checked out.
                </p>

            </div>

        </div>


        <!-- Reservation Details -->
        <div class="completed-details">

            <div class="completed-detail">

                <span>
                    Reservation
                </span>

                <strong>
                    #@ViewBag.ReservationId
                </strong>

            </div>


            <div class="completed-detail">

                <span>
                    Room Status
                </span>

                <strong class="available-status">
                    <i class="bi bi-check-circle"></i>
                    Available
                </strong>

            </div>

        </div>


        <!-- Confirmation -->
        <div class="completed-message">

            <i class="bi bi-info-circle"></i>

            <span>
                The room has been successfully marked as
                <strong>Available</strong> for the next guest.
            </span>

        </div>


        <!-- Action -->
        <a asp-controller="CheckInOut"
           asp-action="Reservations"
           class="completed-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Check-In / Check-Out

        </a>

    </div>

</div>