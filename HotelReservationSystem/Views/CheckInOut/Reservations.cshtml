@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "Check-In / Check-Out";

    var checkInReservations =
        ViewBag.CheckInReservations as IEnumerable<Reservation>
        ?? Enumerable.Empty<Reservation>();

    var checkOutReservations =
        ViewBag.CheckOutReservations as IEnumerable<Reservation>
        ?? Enumerable.Empty<Reservation>();
}

<div class="frontdesk-page">

    <!-- Page Header -->
    <div class="frontdesk-header">

        <div>

            <span class="frontdesk-label">
                FRONT DESK MANAGEMENT
            </span>

            <h1>
                Check-In / Check-Out
            </h1>

            <p>
                Manage guest arrivals and departures
                efficiently from one place.
            </p>

        </div>

        <div class="frontdesk-header-icon">
            <i class="bi bi-building-check"></i>
        </div>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="frontdesk-alert frontdesk-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="frontdesk-alert frontdesk-alert-danger">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <!-- ========================= -->
    <!-- Check-In -->
    <!-- ========================= -->

    <div class="frontdesk-section">

        <div class="frontdesk-section-header">

            <div class="frontdesk-section-title">

                <div class="frontdesk-section-icon checkin-section-icon">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>

                <div>

                    <h2>
                        Reservations Ready for Check-In
                    </h2>

                    <span>
                        Guests arriving at the hotel
                    </span>

                </div>

            </div>


            <div class="frontdesk-count">
                @checkInReservations.Count()
                <span>Reservations</span>
            </div>

        </div>


        <div class="frontdesk-table-wrapper">

            @if (!checkInReservations.Any())
            {
                <div class="frontdesk-empty">

                    <div class="frontdesk-empty-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h3>
                        No Check-Ins Available
                    </h3>

                    <p>
                        There are no reservations ready for check-in.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="frontdesk-table">

                        <thead>

                            <tr>
                                <th>Reservation</th>
                                <th>Guest</th>
                                <th>Room</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>Total Price</th>
                                <th>Payment</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var reservation in checkInReservations)
                            {
                                <tr>

                                    <td>
                                        <span class="reservation-number">
                                            #@reservation.Id
                                        </span>
                                    </td>

                                    <td>

                                        <div class="guest-cell">

                                            <div class="guest-icon">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <span>
                                                @reservation.Guest?.User?.FullName
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="room-number">
                                            @reservation.Room?.RoomNumber
                                        </span>

                                    </td>

                                    <td>
                                        @reservation.CheckInDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @reservation.CheckOutDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        <strong class="price-cell">
                                            @reservation.TotalPrice.ToString("N2") EGP
                                        </strong>

                                    </td>

                                    <td>

                                        <span class="payment-badge">
                                            @reservation.PaymentStatus
                                        </span>

                                    </td>

                                    <td>

                                        <a asp-controller="CheckInOut"
                                           asp-action="CheckIn"
                                           asp-route-id="@reservation.Id"
                                           class="frontdesk-checkin-btn">

                                            <i class="bi bi-box-arrow-in-right"></i>

                                            Check In

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- ========================= -->
    <!-- Check-Out -->
    <!-- ========================= -->

    <div class="frontdesk-section">

        <div class="frontdesk-section-header">

            <div class="frontdesk-section-title">

                <div class="frontdesk-section-icon checkout-section-icon">
                    <i class="bi bi-box-arrow-right"></i>
                </div>

                <div>

                    <h2>
                        Reservations Ready for Check-Out
                    </h2>

                    <span>
                        Guests completing their stay
                    </span>

                </div>

            </div>


            <div class="frontdesk-count">
                @checkOutReservations.Count()
                <span>Reservations</span>
            </div>

        </div>


        <div class="frontdesk-table-wrapper">

            @if (!checkOutReservations.Any())
            {
                <div class="frontdesk-empty">

                    <div class="frontdesk-empty-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>

                    <h3>
                        No Check-Outs Available
                    </h3>

                    <p>
                        There are no guests ready for check-out.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="frontdesk-table">

                        <thead>

                            <tr>
                                <th>Reservation</th>
                                <th>Guest</th>
                                <th>Room</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>Total Price</th>
                                <th>Payment</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var reservation in checkOutReservations)
                            {
                                <tr>

                                    <td>
                                        <span class="reservation-number">
                                            #@reservation.Id
                                        </span>
                                    </td>

                                    <td>

                                        <div class="guest-cell">

                                            <div class="guest-icon">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <span>
                                                @reservation.Guest?.User?.FullName
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="room-number">
                                            @reservation.Room?.RoomNumber
                                        </span>

                                    </td>

                                    <td>
                                        @reservation.CheckInDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @reservation.CheckOutDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        <strong class="price-cell">
                                            @reservation.TotalPrice.ToString("N2") EGP
                                        </strong>

                                    </td>

                                    <td>

                                        <span class="payment-badge">
                                            @reservation.PaymentStatus
                                        </span>

                                    </td>

                                    <td>

                                        <a asp-controller="CheckInOut"
                                           asp-action="CheckOut"
                                           asp-route-id="@reservation.Id"
                                           class="frontdesk-checkout-btn">

                                            <i class="bi bi-box-arrow-right"></i>

                                            Check Out

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>