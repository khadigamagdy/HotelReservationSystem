@model HotelReservationSystem.Models.Entities.Reservation

@{
    ViewData["Title"] = "Check-In Guest";
}

<div class="checkin-page">

    <div class="checkin-card">

        <!-- Header -->
        <div class="checkin-header">

            <div class="checkin-icon">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>

            <span class="checkin-label">
                FRONT DESK
            </span>

            <h1>Guest Check-In</h1>

            <p>
                Review the reservation details carefully before
                confirming the guest's check-in.
            </p>

        </div>


        <!-- Information -->
        <div class="reservation-info-card">

            <div class="reservation-info-title">
                <i class="bi bi-calendar-check"></i>

                <div>
                    <h3>Reservation Details</h3>
                    <span>Review guest and booking information</span>
                </div>
            </div>


            <div class="reservation-details-grid">

                <!-- Reservation ID -->
                <div class="reservation-detail">

                    <span>
                        Reservation ID
                    </span>

                    <strong>
                        #@Model.Id
                    </strong>

                </div>


                <!-- Guest Name -->
                <div class="reservation-detail">

                    <span>
                        Guest Name
                    </span>

                    <strong>
                        @Model.Guest?.User?.FullName
                    </strong>

                </div>


                <!-- Room Number -->
                <div class="reservation-detail">

                    <span>
                        Room Number
                    </span>

                    <strong>
                        @Model.Room?.RoomNumber
                    </strong>

                </div>


                <!-- Room Type -->
                <div class="reservation-detail">

                    <span>
                        Room Type
                    </span>

                    <strong>
                        @Model.Room?.RoomType?.Name
                    </strong>

                </div>


                <!-- Check-In -->
                <div class="reservation-detail">

                    <span>
                        Check-In Date
                    </span>

                    <strong>
                        @Model.CheckInDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>


                <!-- Check-Out -->
                <div class="reservation-detail">

                    <span>
                        Check-Out Date
                    </span>

                    <strong>
                        @Model.CheckOutDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>


                <!-- Total Price -->
                <div class="reservation-detail">

                    <span>
                        Total Price
                    </span>

                    <strong class="price-value">
                        @Model.TotalPrice.ToString("N2") EGP
                    </strong>

                </div>


                <!-- Payment Status -->
                <div class="reservation-detail">

                    <span>
                        Payment Status
                    </span>

                    <strong class="payment-status">
                        @Model.PaymentStatus
                    </strong>

                </div>

            </div>

        </div>


        <!-- Important Notice -->
        <div class="checkin-warning">

            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>

                <strong>
                    Important
                </strong>

                <p>
                    Confirming check-in will mark the reservation as
                    <strong>Checked In</strong> and the room as
                    <strong>Occupied</strong>.
                </p>

            </div>

        </div>


        <!-- Actions -->
        <form asp-controller="CheckInOut"
              asp-action="CheckIn"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <div class="checkin-actions">

                <button type="submit"
                        class="checkin-confirm-btn">

                    <i class="bi bi-check-circle"></i>

                    Confirm Check-In

                </button>


                <a asp-controller="CheckInOut"
                   asp-action="Reservations"
                   class="checkin-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>