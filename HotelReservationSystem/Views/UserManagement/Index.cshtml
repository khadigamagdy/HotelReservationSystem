@model List<HotelReservationSystem.Models.Entities.User>

@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "User Management";

    int totalUsers = Model.Count;

    int guests =
        Model.Count(user =>
            user.Role == UserRole.Guest);

    int receptionists =
        Model.Count(user =>
            user.Role == UserRole.Receptionist);

    int managers =
        Model.Count(user =>
            user.Role == UserRole.Manager);
}

<div class="users-management-page">

    <!-- Header -->
    <div class="users-management-header">

        <div class="users-management-heading">

            <div class="users-management-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>

                <span class="users-management-label">
                    LUXORA HOTEL
                </span>

                <h1>
                    User Management
                </h1>

                <p>
                    View users and manage their system roles.
                </p>

            </div>

        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="users-management-back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="users-management-alert">

            <i class="bi bi-check-circle"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }

    <!-- Summary -->
    <div class="users-management-summary">

        <!-- Total Users -->
        <div class="users-summary-card users-summary-total">

            <div class="users-summary-top">

                <span class="users-summary-label">
                    Total Users
                </span>

                <div class="users-summary-icon">
                    <i class="bi bi-people"></i>
                </div>

            </div>

            <div class="users-summary-value">
                @totalUsers
            </div>

            <p class="users-summary-description">
                Registered system users
            </p>

        </div>

        <!-- Guests -->
        <div class="users-summary-card users-summary-guests">

            <div class="users-summary-top">

                <span class="users-summary-label">
                    Guests
                </span>

                <div class="users-summary-icon">
                    <i class="bi bi-person"></i>
                </div>

            </div>

            <div class="users-summary-value">
                @guests
            </div>

            <p class="users-summary-description">
                Hotel guests
            </p>

        </div>

        <!-- Receptionists -->
        <div class="users-summary-card users-summary-receptionists">

            <div class="users-summary-top">

                <span class="users-summary-label">
                    Receptionists
                </span>

                <div class="users-summary-icon">
                    <i class="bi bi-person-badge"></i>
                </div>

            </div>

            <div class="users-summary-value">
                @receptionists
            </div>

            <p class="users-summary-description">
                Front desk staff
            </p>

        </div>

        <!-- Managers -->
        <div class="users-summary-card users-summary-managers">

            <div class="users-summary-top">

                <span class="users-summary-label">
                    Managers
                </span>

                <div class="users-summary-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

            </div>

            <div class="users-summary-value">
                @managers
            </div>

            <p class="users-summary-description">
                Hotel managers
            </p>

        </div>

    </div>

    <!-- Users Table -->
    <div class="users-management-table-card">

        <div class="users-management-table-header">

            <div>

                <span class="users-management-table-label">
                    SYSTEM USERS
                </span>

                <h2>
                    All Users
                </h2>

            </div>

            <div class="users-management-count">

                <i class="bi bi-person-lines-fill"></i>

                @totalUsers Users

            </div>

        </div>

        @if (Model.Count == 0)
        {
            <div class="users-management-empty">

                <div class="users-management-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>
                    No Users Found
                </h3>

                <p>
                    There are currently no users registered in the system.
                </p>

            </div>
        }
        else
        {
            <div class="users-management-table-wrapper">

                <table class="users-management-table">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Full Name
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Current Role
                            </th>

                            <th>
                                Created At
                            </th>

                            <th>
                                Change Role
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>

                                    <span class="users-management-id">
                                        #@user.Id
                                    </span>

                                </td>

                                <td>

                                    <div class="users-management-name">

                                        <div class="users-management-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <span>
                                            @user.FullName
                                        </span>

                                    </div>

                                </td>

                                <td>

                                    <div class="users-management-email">

                                        <i class="bi bi-envelope"></i>

                                        @user.Email

                                    </div>

                                </td>

                                <td>

                                    <span class="user-role-badge role-@user.Role">

                                        <i class="bi bi-shield-check"></i>

                                        @user.Role

                                    </span>

                                </td>

                                <td>

                                    <div class="users-management-date">

                                        <i class="bi bi-calendar3"></i>

                                        @user.CreatedAt.ToString("dd MMM yyyy")

                                    </div>

                                </td>

                                <td>

                                    <form asp-action="ChangeRole"
                                          method="post"
                                          class="users-role-form">

                                        <input type="hidden"
                                               name="id"
                                               value="@user.Id" />

                                        <div class="users-role-select-wrapper">

                                            <i class="bi bi-shield"></i>

                                            <select name="role"
                                                    class="users-role-select">

                                                @foreach (UserRole role
                                                         in Enum.GetValues<UserRole>())
                                                {
                                                    <option value="@role"
                                                            selected="@(user.Role == role)">
                                                        @role
                                                    </option>
                                                }

                                            </select>

                                        </div>

                                        <button type="submit"
                                                class="users-save-role-btn">

                                            <i class="bi bi-check-lg"></i>

                                            Save

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>