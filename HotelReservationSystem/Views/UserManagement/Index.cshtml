@model List<HotelReservationSystem.Models.User>

@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "User Management";

    int totalUsers = Model.Count;

    int guests =
        Model.Count(user =>
            user.Role == UserRole.Guest);

    int receptionists =
        Model.Count(user =>
            user.Role == UserRole.Receptionist);

    int managers =
        Model.Count(user =>
            user.Role == UserRole.Manager);
}

<style>
    .users-page {
        padding: 35px 0;
    }

    .users-header {
        background: linear-gradient(135deg, #0f172a, #be123c);
        color: white;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 25px;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.14);
    }

        .users-header h1 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .users-header p {
            color: #ffe4e6;
            margin: 0;
        }

    .summary-card {
        height: 100%;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 7px 20px rgba(15, 23, 42, 0.06);
    }

        .summary-card span {
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }

        .summary-card h3 {
            color: #0f172a;
            font-weight: 750;
            margin-top: 8px;
            margin-bottom: 0;
        }

    .users-table-container {
        margin-top: 25px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 22px;
        overflow-x: auto;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    .users-table {
        width: 100%;
    }

        .users-table th {
            padding: 14px;
            background: #f1f5f9;
            color: #334155;
            white-space: nowrap;
        }

        .users-table td {
            padding: 14px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    .role-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .role-Guest {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .role-Receptionist {
        color: #7e22ce;
        background: #f3e8ff;
    }

    .role-Manager {
        color: #b91c1c;
        background: #fee2e2;
    }

    .role-form {
        display: flex;
        gap: 8px;
        min-width: 260px;
    }

    .role-select {
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        padding: 8px 10px;
    }

    .save-role-button {
        border: 0;
        border-radius: 9px;
        padding: 8px 14px;
        color: white;
        background: #1d4ed8;
        font-weight: 600;
    }

    .back-link {
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 10px;
        padding: 9px 15px;
        text-decoration: none;
    }
</style>

<div class="container users-page">
    <div class="users-header">
        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3">

            <div>
                <h1>User Management</h1>

                <p>
                    View users and manage their system roles.
                </p>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="back-link">
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-3">
        <div class="col-md-3">
            <div class="summary-card">
                <span>Total Users</span>
                <h3>@totalUsers</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="summary-card">
                <span>Guests</span>
                <h3>@guests</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="summary-card">
                <span>Receptionists</span>
                <h3>@receptionists</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="summary-card">
                <span>Managers</span>
                <h3>@managers</h3>
            </div>
        </div>
    </div>

    <div class="users-table-container">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                No users were found.
            </div>
        }
        else
        {
            <table class="users-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Current Role</th>
                        <th>Created At</th>
                        <th>Change Role</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>#@user.Id</td>

                            <td class="fw-semibold">
                                @user.FullName
                            </td>

                            <td>@user.Email</td>

                            <td>
                                <span class="role-badge role-@user.Role">
                                    @user.Role
                                </span>
                            </td>

                            <td>
                                @user.CreatedAt
                                .ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <form asp-action="ChangeRole"
                                      method="post"
                                      class="role-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <select name="role"
                                            class="role-select">

                                        @foreach (UserRole role
                                                                        in Enum.GetValues<UserRole>())
                                        {
                                            <option value="@role"
                                                    selected="@(user.Role == role)">
                                                @role
                                            </option>
                                        }
                                    </select>

                                    <button type="submit"
                                            class="save-role-button">
                                        Save
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>