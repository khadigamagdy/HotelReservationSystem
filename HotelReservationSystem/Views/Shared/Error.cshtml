@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="error-page">

    <div class="error-card">

        <div class="error-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <span class="error-label">
            LUXORA HOTEL
        </span>

        <h1 class="error-title">
            Something Went Wrong
        </h1>

        <p class="error-message">
            An error occurred while processing your request.
            Please try again or return to the home page.
        </p>


        @if (Model.ShowRequestId)
        {
            <div class="error-request-box">

                <div class="error-request-icon">
                    <i class="bi bi-fingerprint"></i>
                </div>

                <div class="error-request-content">

                    <span>
                        Request ID
                    </span>

                    <code>
                        @Model.RequestId
                    </code>

                </div>

            </div>
        }


        <div class="error-development-box">

            <div class="error-development-header">

                <i class="bi bi-code-slash"></i>

                <h3>
                    Development Mode
                </h3>

            </div>

            <p>
                Swapping to <strong>Development</strong> environment
                will display more detailed information about the error
                that occurred.
            </p>

            <p>
                <strong>
                    The Development environment shouldn't be enabled
                    for deployed applications.
                </strong>
                It can result in displaying sensitive information from
                exceptions to end users.
            </p>

            <p>
                For local debugging, enable the
                <strong>ASPNETCORE_ENVIRONMENT</strong> environment
                variable to <strong>Development</strong> and restart
                the app.
            </p>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="error-home-btn">

            <i class="bi bi-house-door"></i>

            Back to Home

        </a>

    </div>

</div>