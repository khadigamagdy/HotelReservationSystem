<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Luxora Hotel
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HotelReservationSystem.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- Navigation -->
    <header>

        <nav class="navbar navbar-expand-lg hotel-navbar">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand hotel-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="hotel-brand-icon">
                        <i class="bi bi-buildings"></i>
                    </span>

                    <span>
                        Luxora Hotel
                    </span>

                </a>


                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation Links -->
                <div id="mainNavbar"
                     class="collapse navbar-collapse">


                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 hotel-nav-links">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>

                                Home

                            </a>

                        </li>

                        <!-- Rooms (hidden for Guests) -->
                        @if (!User.IsInRole("Guest"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Rooms"
                                   asp-action="Index">

                                    <i class="bi bi-door-open"></i>

                                    Rooms

                                </a>

                            </li>
                        }


                        <!-- Manager Navigation -->
                        @if (User.IsInRole("Manager"))
                        {

                            <!-- Dashboard -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2"></i>

                                    Dashboard

                                </a>

                            </li>


                            <!-- Reports -->
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-bar-chart-line"></i>

                                    Reports

                                </a>


                                <ul class="dropdown-menu hotel-dropdown-menu">

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="Reservations">

                                            <i class="bi bi-calendar2-check"></i>

                                            Reservations

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="Payments">

                                            <i class="bi bi-credit-card"></i>

                                            Payments

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="Rooms">

                                            <i class="bi bi-door-open"></i>

                                            Rooms

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="Revenue">

                                            <i class="bi bi-graph-up-arrow"></i>

                                            Revenue

                                        </a>

                                    </li>

                                </ul>

                            </li>


                            <!-- Users -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="UserManagement"
                                   asp-action="Index">

                                    <i class="bi bi-people"></i>

                                    Users

                                </a>

                            </li>

                        }

                        <!-- Guest-specific links -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Guest"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reservation"
                                       asp-action="Search">

                                        <i class="bi bi-plus-circle"></i>

                                        Create Reservation

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reservation"
                                       asp-action="MyReservations">

                                        <i class="bi bi-calendar-check"></i>

                                        My Reservations

                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    <!-- Account Area -->
                    <div class="hotel-account-area">

                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <div class="hotel-user-info">

                                <div class="hotel-user-icon">
                                    <i class="bi bi-person-circle"></i>
                                </div>

                                <div class="hotel-user-text">

                                    <span>
                                        Welcome
                                    </span>

                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                </div>

                            </div>


                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="logout-button">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Logout

                                </button>

                            </form>

                        }
                        else
                        {

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="login-link">

                                <i class="bi bi-box-arrow-in-right"></i>

                                Login

                            </a>


                            <a asp-controller="Account"
                               asp-action="Register"
                               class="register-link">

                                <i class="bi bi-person-plus"></i>

                                Register

                            </a>

                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Content -->
    <main role="main"
          class="hotel-main-content">

        @RenderBody()

    </main>


    <!-- Footer -->
    <footer class="hotel-footer">

        <div class="container">

            <div class="hotel-footer-content">

                <div class="hotel-footer-brand">

                    <div class="hotel-footer-logo">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <div>

                        <strong>
                            Luxora Hotel
                        </strong>

                        <span>
                            Experience Comfort. Stay Extraordinary.
                        </span>

                    </div>

                </div>


                <div class="hotel-footer-copy">

                    &copy; 2026 Luxora Hotel.
                    All rights reserved.

                </div>

            </div>

        </div>

    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>