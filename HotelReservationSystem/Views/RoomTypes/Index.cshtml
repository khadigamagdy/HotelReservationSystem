@model IEnumerable<HotelReservationSystem.Models.Entities.RoomType>

<h1>Room Types</h1>

<a asp-action="Create" class="btn btn-primary">
    Add Room Type
</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price Per Night</th>
            <th>Capacity</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var type in Model)
        {
            <tr>
                <td>@type.Name</td>
                <td>@type.BasePricePerNight</td>
                <td>@type.Capacity</td>
                <td>@type.Description</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@type.Id">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@type.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>