@model HotelReservationSystem.Models.Entities.RoomType

@{
    ViewData["Title"] = "Edit Room Type";
}

<h1>Edit Room Type</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <!-- Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label asp-for="BasePricePerNight"
                       class="form-label">
                </label>

                <input asp-for="BasePricePerNight"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0" />

                <span asp-validation-for="BasePricePerNight"
                      class="text-danger"></span>
            </div>

            <!-- Capacity -->
            <div class="mb-3">
                <label asp-for="Capacity"
                       class="form-label">
                </label>

                <input asp-for="Capacity"
                       class="form-control"
                       type="number"
                       min="1"
                       max="20" />

                <span asp-validation-for="Capacity"
                      class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
