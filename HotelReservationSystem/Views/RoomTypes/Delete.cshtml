@model HotelReservationSystem.Models.Entities.RoomType

@{
    ViewData["Title"] = "Delete Room Type";
}

<div class="roomtype-delete-page">

    <div class="roomtype-delete-card">

        <!-- Header -->
        <div class="roomtype-delete-header">

            <div class="roomtype-delete-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <span class="roomtype-delete-label">
                ROOM TYPE MANAGEMENT
            </span>

            <h1>
                Delete Room Type
            </h1>

            <p>
                Are you sure you want to delete this room type?
                Please review the information before continuing.
            </p>

        </div>


        <!-- Warning -->
        <div class="roomtype-delete-warning">

            <div class="roomtype-delete-warning-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>

                <strong>
                    Warning
                </strong>

                <p>
                    This action cannot be undone.
                    Make sure you are deleting the correct room type.
                </p>

            </div>

        </div>


        <!-- Room Type Details -->
        <div class="roomtype-delete-details">

            <div class="roomtype-delete-detail">

                <div class="roomtype-delete-detail-icon">
                    <i class="bi bi-house-door"></i>
                </div>

                <div>

                    <span>
                        Room Type
                    </span>

                    <strong>
                        @Html.DisplayFor(model => model.Name)
                    </strong>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="roomtype-delete-actions">

                <button type="submit"
                        class="roomtype-delete-confirm-btn">

                    <i class="bi bi-trash3"></i>

                    Delete Room Type

                </button>


                <a asp-action="Index"
                   class="roomtype-delete-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>