@model HotelReservationSystem.Models.Entities.Amenity

@{
    ViewData["Title"] = "Delete Amenity";
}

<div class="management-page">

    <div class="delete-card">

        <!-- Icon -->
        <div class="delete-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <!-- Header -->
        <div class="management-header">

            <span class="management-label">
                HOTEL MANAGEMENT
            </span>

            <h1>Delete Amenity</h1>

            <p>
                Are you sure you want to delete this amenity?
                This action cannot be undone.
            </p>

        </div>


        <!-- Amenity Details -->
        <div class="delete-details">

            <div class="delete-detail-item">

                <span class="delete-detail-label">
                    Amenity Name
                </span>

                <strong>
                    @Html.DisplayFor(model => model.Name)
                </strong>

            </div>

        </div>


        <!-- Actions -->
        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="delete-actions">

                <button type="submit"
                        class="delete-primary-btn">

                    <i class="bi bi-trash3"></i>

                    Delete Amenity

                </button>

                <a asp-action="Index"
                   class="delete-secondary-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>