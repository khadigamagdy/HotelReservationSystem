@model HotelReservationSystem.Models.Entities.Amenity

@{
    ViewData["Title"] = "Create Amenity";
}

<div class="management-page">

    <div class="management-card">

        <!-- Header -->
        <div class="management-header">

            <div class="management-icon">
                <i class="bi bi-plus-circle"></i>
            </div>

            <span class="management-label">
                HOTEL MANAGEMENT
            </span>

            <h1>Create Amenity</h1>

            <p>
                Add a new amenity to make your hotel rooms
                more comfortable and convenient for guests.
            </p>

        </div>


        <!-- Form -->
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="management-validation">
            </div>


            <!-- Amenity Name -->
            <div class="management-form-group">

                <label asp-for="Name">
                    Amenity Name
                </label>

                <div class="management-input-wrapper">

                    <i class="bi bi-stars"></i>

                    <input asp-for="Name"
                           class="management-input"
                           placeholder="Enter amenity name" />

                </div>

                <span asp-validation-for="Name"
                      class="management-field-error">
                </span>

            </div>


            <!-- Actions -->
            <div class="management-actions">

                <button type="submit"
                        class="management-primary-btn">

                    <i class="bi bi-check-lg"></i>

                    Create Amenity

                </button>

                <a asp-action="Index"
                   class="management-secondary-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back to List

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}