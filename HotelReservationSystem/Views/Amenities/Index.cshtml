@model IEnumerable<HotelReservationSystem.Models.Entities.Amenity>

@{
    ViewData["Title"] = "Amenities";
}

<div class="management-list-page">

    <!-- Page Header -->
    <div class="management-list-header">

        <div>
            <span class="management-label">
                HOTEL MANAGEMENT
            </span>

            <h1>Amenities</h1>

            <p>
                Manage the amenities available throughout your hotel.
            </p>
        </div>

        <a asp-action="Create"
           class="management-add-btn">

            <i class="bi bi-plus-lg"></i>

            Create New Amenity

        </a>

    </div>


    <!-- Amenities Card -->
    <div class="management-table-card">

        <div class="management-table-header">

            <div>
                <h3>
                    <i class="bi bi-stars"></i>
                    Hotel Amenities
                </h3>

                <span>
                    Manage and update your available amenities
                </span>
            </div>

        </div>


        <div class="table-responsive">

            <table class="management-table">

                <thead>

                    <tr>

                        <th>
                            Amenity
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <div class="amenity-name">

                                    <div class="amenity-list-icon">
                                        <i class="bi bi-stars"></i>
                                    </div>

                                    <span>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </span>

                                </div>

                            </td>


                            <td>

                                <div class="amenity-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="table-edit-btn">

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="table-delete-btn">

                                        <i class="bi bi-trash3"></i>

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>