
@model HotelReservationSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="mb-0">Payment Details</h3>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <strong>Payment ID:</strong>
                        <span>#@Model.Id</span>
                    </div>

                    <div class="mb-3">
                        <strong>Reservation ID:</strong>
                        <span>#@Model.ReservationId</span>
                    </div>

                    <div class="mb-3">
                        <strong>Amount:</strong>
                        <span>@Model.Amount EGP</span>
                    </div>

                    <div class="mb-3">
                        <strong>Payment Method:</strong>
                        <span>@Model.Method</span>
                    </div>

                    <div class="mb-3">
                        <strong>Paid At:</strong>
                        <span>@Model.PaidAt.ToLocalTime()</span>
                    </div>

                    <div class="mb-3">
                        <strong>Recorded By:</strong>
                        <span>
                            @(Model.RecordedByUser?.FullName ?? "System")
                        </span>
                    </div>

                    <div class="mt-4">

                        <a asp-controller="Payments"
                           asp-action="ReservationPayments"
                           asp-route-reservationId="@Model.ReservationId"
                           class="btn btn-secondary">
                            Back to Payments
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>