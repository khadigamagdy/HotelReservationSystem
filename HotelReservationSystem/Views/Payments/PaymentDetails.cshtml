@model HotelReservationSystem.Models.Entities.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="payment-details-page">

    <div class="payment-details-card">

        <!-- Header -->
        <div class="payment-details-header">

            <div class="payment-details-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <span class="payment-details-label">
                PAYMENT MANAGEMENT
            </span>

            <h1>
                Payment Details
            </h1>

            <p>
                Review the complete information for this
                payment transaction.
            </p>

        </div>


        <!-- Payment Amount -->
        <div class="payment-amount-highlight">

            <span>
                Payment Amount
            </span>

            <strong>
                @Model.Amount.ToString("N2")
                <small>EGP</small>
            </strong>

        </div>


        <!-- Payment Information -->
        <div class="payment-details-section">

            <div class="payment-details-section-title">

                <div class="payment-details-section-icon">
                    <i class="bi bi-info-circle"></i>
                </div>

                <div>
                    <h3>
                        Transaction Information
                    </h3>

                    <span>
                        Payment and reservation details
                    </span>
                </div>

            </div>


            <div class="payment-details-grid">

                <div class="payment-detail-item">

                    <span>
                        Payment ID
                    </span>

                    <strong>
                        #@Model.Id
                    </strong>

                </div>


                <div class="payment-detail-item">

                    <span>
                        Reservation ID
                    </span>

                    <strong>
                        #@Model.ReservationId
                    </strong>

                </div>


                <div class="payment-detail-item">

                    <span>
                        Payment Method
                    </span>

                    <strong class="payment-method-value">

                        <i class="bi bi-wallet2"></i>

                        @Model.Method

                    </strong>

                </div>


                <div class="payment-detail-item">

                    <span>
                        Paid At
                    </span>

                    <strong>

                        <i class="bi bi-clock"></i>

                        @Model.PaidAt.ToLocalTime()

                    </strong>

                </div>


                <div class="payment-detail-item payment-recorded-by">

                    <span>
                        Recorded By
                    </span>

                    <strong>

                        <i class="bi bi-person-check"></i>

                        @(Model.RecordedByUser?.FullName ?? "System")

                    </strong>

                </div>

            </div>

        </div>


        <!-- Transaction Status -->
        <div class="payment-confirmation-box">

            <div class="payment-confirmation-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>
                    Payment Recorded Successfully
                </strong>

                <p>
                    This transaction has been successfully
                    recorded in the hotel payment system.
                </p>

            </div>

        </div>


        <!-- Actions -->
        <div class="payment-details-actions">

            <a asp-controller="Payments"
               asp-action="ReservationPayments"
               asp-route-reservationId="@Model.ReservationId"
               class="payment-details-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Payments

            </a>

        </div>

    </div>

</div>