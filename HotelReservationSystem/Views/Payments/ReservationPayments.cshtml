@model IEnumerable<HotelReservationSystem.Models.Entities.Payment>

@{
    ViewData["Title"] = "Reservation Payments";

    var reservationId = ViewBag.ReservationId;
    var totalPaid = ViewBag.TotalPaid ?? 0;
}

<div class="reservation-payments-page">

    <!-- Page Header -->
    <div class="reservation-payments-header">

        <div>

            <span class="reservation-payments-label">
                PAYMENT MANAGEMENT
            </span>

            <h1>
                Reservation Payments
            </h1>

            <p>
                Review and manage all payments recorded
                for this reservation.
            </p>

        </div>


        <a asp-controller="Payments"
           asp-action="Create"
           asp-route-reservationId="@reservationId"
           class="reservation-add-payment-btn">

            <i class="bi bi-plus-lg"></i>

            Add Payment

        </a>

    </div>


    <!-- Reservation Reference -->
    <div class="reservation-reference">

        <div class="reservation-reference-icon">
            <i class="bi bi-calendar-check"></i>
        </div>

        <div>

            <span>
                Reservation
            </span>

            <strong>
                #@reservationId
            </strong>

        </div>

    </div>


    <!-- Payment Statistics -->
    <div class="row g-4 reservation-payment-stats">

        <div class="col-md-6">

            <div class="reservation-payment-stat-card">

                <div class="reservation-payment-stat-icon stat-green">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>

                    <span>
                        Total Paid
                    </span>

                    <strong>
                        @totalPaid
                        <small>EGP</small>
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="reservation-payment-stat-card">

                <div class="reservation-payment-stat-icon stat-blue">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>

                    <span>
                        Number of Payments
                    </span>

                    <strong>
                        @Model.Count()
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- Payments Table -->
    <div class="reservation-payments-table-card">

        <div class="reservation-payments-table-header">

            <div class="reservation-payments-table-title">

                <div class="reservation-payments-table-icon">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>

                <div>

                    <h2>
                        Payment History
                    </h2>

                    <span>
                        All transactions for reservation #@reservationId
                    </span>

                </div>

            </div>

        </div>


        @if (!Model.Any())
        {
            <div class="reservation-payments-empty">

                <div class="reservation-payments-empty-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <h3>
                    No Payments Yet
                </h3>

                <p>
                    No payments have been recorded for this
                    reservation yet.
                </p>

                <a asp-controller="Payments"
                   asp-action="Create"
                   asp-route-reservationId="@reservationId"
                   class="reservation-empty-payment-btn">

                    <i class="bi bi-plus-lg"></i>

                    Add First Payment

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="reservation-payments-table">

                    <thead>

                        <tr>
                            <th>Payment ID</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Paid At</th>
                            <th>Recorded By</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var payment in Model)
                        {
                            <tr>

                                <td>

                                    <span class="payment-id-badge">
                                        #@payment.Id
                                    </span>

                                </td>


                                <td>

                                    <strong class="payment-amount-value">
                                        @payment.Amount.ToString("N2") EGP
                                    </strong>

                                </td>


                                <td>

                                    <span class="payment-method-badge">

                                        <i class="bi bi-wallet2"></i>

                                        @payment.Method

                                    </span>

                                </td>


                                <td>

                                    <div class="payment-date">

                                        <i class="bi bi-clock"></i>

                                        <span>
                                            @payment.PaidAt.ToLocalTime()
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <div class="payment-recorded-user">

                                        <div class="payment-user-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <span>
                                            @(payment.RecordedByUser?.FullName ?? "System")
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <a asp-controller="Payments"
                                       asp-action="PaymentDetails"
                                       asp-route-id="@payment.Id"
                                       class="payment-details-btn">

                                        <i class="bi bi-eye"></i>

                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>