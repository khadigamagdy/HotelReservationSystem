
@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "Add Payment";
    var reservationId = ViewBag.ReservationId;
    var totalPaid = ViewBag.TotalPaid ?? 0;
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="mb-0">Add Payment</h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-light border">
                        <strong>Reservation ID:</strong>
                        @reservationId
                    </div>

                    <div class="alert alert-info">
                        <strong>Total Paid:</strong>
                        @totalPaid EGP
                    </div>

                    <form asp-controller="Payments"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="reservationId"
                               value="@reservationId" />

                        <div class="mb-3">

                            <label for="amount"
                                   class="form-label">
                                Payment Amount
                            </label>

                            <input type="number"
                                   id="amount"
                                   name="amount"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   required />

                            <span class="text-danger">
                                @Html.ValidationMessage("amount")
                            </span>

                        </div>

                        <div class="mb-3">

                            <label for="method"
                                   class="form-label">
                                Payment Method
                            </label>

                            <select id="method"
                                    name="method"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<PaymentMethod>()">
                            </select>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Payment
                            </button>

                            <a asp-controller="Payments"
                               asp-action="ReservationPayments"
                               asp-route-reservationId="@reservationId"
                               class="btn btn-secondary">
                                Back
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


