@model List<HotelReservationSystem.ViewModels.RevenueReportViewModel>

@{
    ViewData["Title"] = "Revenue Report";

    decimal totalRevenue =
        Model.Sum(report => report.TotalRevenue);

    int totalPayments =
        Model.Sum(report => report.PaymentsCount);

    decimal averageMonthlyRevenue =
        Model.Count > 0
            ? Model.Average(report => report.TotalRevenue)
            : 0;

    decimal highestRevenue =
        Model.Count > 0
            ? Model.Max(report => report.TotalRevenue)
            : 0;
}

<div class="revenue-report-page">

    <!-- Report Header -->
    <div class="revenue-report-header">

        <div class="revenue-report-heading">

            <span class="revenue-report-label">
                HOTEL ANALYTICS
            </span>

            <h1>
                Revenue Report
            </h1>

            <p>
                Track monthly hotel revenue and payment
                performance over time.
            </p>

        </div>

        <div class="revenue-report-header-actions">

            <div class="revenue-report-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="revenue-report-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>

    </div>


    <!-- Revenue Summary -->
    <div class="row g-4 revenue-report-summary">

        <!-- Total Revenue -->
        <div class="col-md-4">

            <div class="revenue-summary-card">

                <div class="revenue-summary-top">

                    <span>
                        Total Revenue
                    </span>

                    <div class="revenue-summary-icon revenue-green">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

                <strong class="revenue-summary-value">
                    @totalRevenue.ToString("N2")
                    <small>EGP</small>
                </strong>

                <span class="revenue-summary-description">
                    Total revenue generated
                </span>

            </div>

        </div>


        <!-- Total Payments -->
        <div class="col-md-4">

            <div class="revenue-summary-card">

                <div class="revenue-summary-top">

                    <span>
                        Total Payments
                    </span>

                    <div class="revenue-summary-icon revenue-blue">
                        <i class="bi bi-credit-card"></i>
                    </div>

                </div>

                <strong class="revenue-summary-value">
                    @totalPayments
                </strong>

                <span class="revenue-summary-description">
                    Recorded payment transactions
                </span>

            </div>

        </div>


        <!-- Average Monthly Revenue -->
        <div class="col-md-4">

            <div class="revenue-summary-card">

                <div class="revenue-summary-top">

                    <span>
                        Average Monthly Revenue
                    </span>

                    <div class="revenue-summary-icon revenue-gold">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>

                </div>

                <strong class="revenue-summary-value">
                    @averageMonthlyRevenue.ToString("N2")
                    <small>EGP</small>
                </strong>

                <span class="revenue-summary-description">
                    Average revenue per month
                </span>

            </div>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <!-- Empty State -->
        <div class="revenue-report-empty">

            <div class="revenue-report-empty-icon">
                <i class="bi bi-graph-down"></i>
            </div>

            <h3>
                No Revenue Data Found
            </h3>

            <p>
                There is currently no revenue data available
                for the selected period.
            </p>

        </div>
    }
    else
    {
        <!-- Monthly Revenue Overview -->
        <div class="revenue-overview-card">

            <div class="revenue-overview-header">

                <div class="revenue-overview-title">

                    <div class="revenue-overview-icon">
                        <i class="bi bi-graph-up"></i>
                    </div>

                    <div>

                        <span class="revenue-overview-label">
                            PERFORMANCE
                        </span>

                        <h2>
                            Monthly Revenue Overview
                        </h2>

                        <p>
                            Compare revenue performance across months.
                        </p>

                    </div>

                </div>

            </div>


            <div class="revenue-chart-list">

                @foreach (var report in Model)
                {
                    decimal width =
                        highestRevenue > 0
                            ? report.TotalRevenue /
                              highestRevenue * 100
                            : 0;

                    <div class="revenue-row">

                        <div class="revenue-info">

                            <div class="revenue-month-info">

                                <div class="revenue-month-icon">
                                    <i class="bi bi-calendar3"></i>
                                </div>

                                <span class="revenue-month">
                                    @report.MonthName @report.Year
                                </span>

                            </div>

                            <span class="revenue-amount">
                                @report.TotalRevenue.ToString("N2") EGP
                            </span>

                        </div>


                        <div class="revenue-bar-background">

                            <div class="revenue-bar"
                                 style="width: @width.ToString(
                                                                     "0.##",
                                                                     System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- Revenue Details Table -->
        <div class="revenue-report-table-card">

            <div class="revenue-report-table-header">

                <div class="revenue-report-table-title">

                    <div class="revenue-report-table-icon">
                        <i class="bi bi-table"></i>
                    </div>

                    <div>

                        <span class="revenue-table-label">
                            REVENUE BREAKDOWN
                        </span>

                        <h2>
                            Monthly Revenue Details
                        </h2>

                        <p>
                            Detailed monthly payment and revenue summary.
                        </p>

                    </div>

                </div>


                <div class="revenue-report-count">

                    @Model.Count

                    <span>
                        Months
                    </span>

                </div>

            </div>


            <div class="table-responsive">

                <table class="revenue-report-table">

                    <thead>

                        <tr>
                            <th>Month</th>
                            <th>Year</th>
                            <th>Payments Count</th>
                            <th>Total Revenue</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var report in Model)
                        {
                            <tr>

                                <td>

                                    <div class="revenue-table-month">

                                        <div class="revenue-table-month-icon">
                                            <i class="bi bi-calendar3"></i>
                                        </div>

                                        <strong>
                                            @report.MonthName
                                        </strong>

                                    </div>

                                </td>


                                <td>

                                    <span class="revenue-year">
                                        @report.Year
                                    </span>

                                </td>


                                <td>

                                    <span class="revenue-payments-count">

                                        <i class="bi bi-credit-card"></i>

                                        @report.PaymentsCount

                                    </span>

                                </td>


                                <td>

                                    <strong class="revenue-table-value">
                                        @report.TotalRevenue.ToString("N2")
                                        <small>EGP</small>
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>