@model List<HotelReservationSystem.Models.Entities.Reservation>

@{
    ViewData["Title"] = "Reservations Report";

    int totalReservations = Model.Count;

    int bookedReservations = Model.Count(
        reservation =>
            reservation.BookingStatus ==
            HotelReservationSystem.Enums.BookingStatus.Booked);

    int checkedInReservations = Model.Count(
        reservation =>
            reservation.BookingStatus ==
            HotelReservationSystem.Enums.BookingStatus.CheckedIn);

    int checkedOutReservations = Model.Count(
        reservation =>
            reservation.BookingStatus ==
            HotelReservationSystem.Enums.BookingStatus.CheckedOut);
}

<div class="reservations-report-page">

    <!-- Report Header -->
    <div class="reservations-report-header">

        <div class="reservations-report-heading">

            <span class="reservations-report-label">
                HOTEL ANALYTICS
            </span>

            <h1>
                Reservations Report
            </h1>

            <p>
                Review hotel reservations, guest stays and
                current booking status in detail.
            </p>

        </div>

        <div class="reservations-report-icon">
            <i class="bi bi-calendar2-check"></i>
        </div>

    </div>


    <!-- Reservation Summary -->
    <div class="row g-4 reservations-report-summary">

        <!-- Total -->
        <div class="col-md-6 col-xl-3">

            <div class="reservations-summary-card">

                <div class="reservations-summary-top">

                    <span>
                        Total Reservations
                    </span>

                    <div class="reservations-summary-icon summary-blue">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                </div>

                <strong class="reservations-summary-value">
                    @totalReservations
                </strong>

                <span class="reservations-summary-description">
                    All hotel bookings
                </span>

            </div>

        </div>


        <!-- Booked -->
        <div class="col-md-6 col-xl-3">

            <div class="reservations-summary-card">

                <div class="reservations-summary-top">

                    <span>
                        Booked
                    </span>

                    <div class="reservations-summary-icon summary-blue">
                        <i class="bi bi-calendar-plus"></i>
                    </div>

                </div>

                <strong class="reservations-summary-value">
                    @bookedReservations
                </strong>

                <span class="reservations-summary-description">
                    Confirmed bookings
                </span>

            </div>

        </div>


        <!-- Checked In -->
        <div class="col-md-6 col-xl-3">

            <div class="reservations-summary-card">

                <div class="reservations-summary-top">

                    <span>
                        Checked In
                    </span>

                    <div class="reservations-summary-icon summary-green">
                        <i class="bi bi-person-check"></i>
                    </div>

                </div>

                <strong class="reservations-summary-value">
                    @checkedInReservations
                </strong>

                <span class="reservations-summary-description">
                    Guests currently staying
                </span>

            </div>

        </div>


        <!-- Checked Out -->
        <div class="col-md-6 col-xl-3">

            <div class="reservations-summary-card">

                <div class="reservations-summary-top">

                    <span>
                        Checked Out
                    </span>

                    <div class="reservations-summary-icon summary-gray">
                        <i class="bi bi-person-check-fill"></i>
                    </div>

                </div>

                <strong class="reservations-summary-value">
                    @checkedOutReservations
                </strong>

                <span class="reservations-summary-description">
                    Completed stays
                </span>

            </div>

        </div>

    </div>


    <!-- Reservations Table -->
    <div class="reservations-report-table-card">

        <div class="reservations-report-table-header">

            <div class="reservations-report-table-title">

                <div class="reservations-report-table-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>

                    <span class="reservations-table-label">
                        RESERVATION HISTORY
                    </span>

                    <h2>
                        All Reservations
                    </h2>

                    <p>
                        Detailed overview of every hotel reservation.
                    </p>

                </div>

            </div>


            <div class="reservations-report-count">

                @Model.Count

                <span>
                    Reservations
                </span>

            </div>

        </div>


        @if (Model.Count == 0)
        {
            <div class="reservations-report-empty">

                <div class="reservations-report-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h3>
                    No Reservations Found
                </h3>

                <p>
                    There are currently no reservations
                    available in the system.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="reservations-report-table">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Room Type</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Total Price</th>
                            <th>Paid</th>
                            <th>Payment</th>
                            <th>Booking</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var reservation in Model)
                        {
                            decimal paidAmount =
                                reservation.Payments.Sum(
                                    payment => payment.Amount);

                            <tr>

                                <!-- ID -->
                                <td>

                                    <span class="reservation-report-id">
                                        #@reservation.Id
                                    </span>

                                </td>


                                <!-- Guest -->
                                <td>

                                    <div class="reservation-report-guest">

                                        <div class="reservation-report-guest-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <span>
                                            @reservation.Guest.User.FullName
                                        </span>

                                    </div>

                                </td>


                                <!-- Room -->
                                <td>

                                    <span class="reservation-report-room">
                                        <i class="bi bi-door-open"></i>
                                        @reservation.Room.RoomNumber
                                    </span>

                                </td>


                                <!-- Room Type -->
                                <td>

                                    <span class="reservation-report-room-type">
                                        @reservation.Room.RoomType.Name
                                    </span>

                                </td>


                                <!-- Check In -->
                                <td>

                                    <div class="reservation-report-date">

                                        <i class="bi bi-calendar-event"></i>

                                        <span>
                                            @reservation.CheckInDate
                                            .ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </td>


                                <!-- Check Out -->
                                <td>

                                    <div class="reservation-report-date">

                                        <i class="bi bi-calendar-event"></i>

                                        <span>
                                            @reservation.CheckOutDate
                                            .ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </td>


                                <!-- Total Price -->
                                <td>

                                    <strong class="reservation-report-price">
                                        @reservation.TotalPrice
                                        .ToString("N2") EGP
                                    </strong>

                                </td>


                                <!-- Paid -->
                                <td>

                                    <strong class="reservation-report-paid">
                                        @paidAmount.ToString("N2") EGP
                                    </strong>

                                </td>


                                <!-- Payment Status -->
                                <td>

                                    <span class="reservation-status-badge payment-@reservation.PaymentStatus">

                                        @if (reservation.PaymentStatus.ToString() == "Paid")
                                        {
                                            <i class="bi bi-check-circle"></i>
                                        }
                                        else if (reservation.PaymentStatus.ToString() == "PartiallyPaid")
                                        {
                                            <i class="bi bi-hourglass-split"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-exclamation-circle"></i>
                                        }

                                        @reservation.PaymentStatus

                                    </span>

                                </td>


                                <!-- Booking Status -->
                                <td>

                                    <span class="reservation-status-badge status-@reservation.BookingStatus">

                                        @if (reservation.BookingStatus.ToString() == "Booked")
                                        {
                                            <i class="bi bi-calendar-check"></i>
                                        }
                                        else if (reservation.BookingStatus.ToString() == "CheckedIn")
                                        {
                                            <i class="bi bi-person-check"></i>
                                        }
                                        else if (reservation.BookingStatus.ToString() == "CheckedOut")
                                        {
                                            <i class="bi bi-check2-all"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle"></i>
                                        }

                                        @reservation.BookingStatus

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>