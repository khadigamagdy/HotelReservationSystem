@model List<HotelReservationSystem.Models.Entities.Payment>

@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "Payments Report";

    decimal totalRevenue =
        Model.Sum(payment => payment.Amount);

    int cashPayments =
        Model.Count(payment =>
            payment.Method == PaymentMethod.Cash);

    int cardPayments =
        Model.Count(payment =>
            payment.Method == PaymentMethod.Card);

    int onlinePayments =
        Model.Count(payment =>
            payment.Method == PaymentMethod.Online);
}

<div class="payments-report-page">

    <!-- Report Header -->
    <div class="payments-report-header">

        <div class="payments-report-heading">

            <span class="payments-report-label">
                HOTEL ANALYTICS
            </span>

            <h1>
                Payments Report
            </h1>

            <p>
                Review payment activity, transaction methods
                and hotel revenue in detail.
            </p>

        </div>


        <div class="payments-report-header-actions">

            <div class="payments-report-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="payments-report-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>

    </div>


    <!-- Summary -->
    <div class="row g-4 payments-report-summary">

        <!-- Total Revenue -->
        <div class="col-md-6 col-xl-3">

            <div class="payments-summary-card">

                <div class="payments-summary-top">

                    <span>
                        Total Revenue
                    </span>

                    <div class="payments-summary-icon summary-green">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

                <strong class="payments-summary-value">
                    @totalRevenue.ToString("N2")
                    <small>EGP</small>
                </strong>

                <span class="payments-summary-description">
                    Total recorded payments
                </span>

            </div>

        </div>


        <!-- Cash Payments -->
        <div class="col-md-6 col-xl-3">

            <div class="payments-summary-card">

                <div class="payments-summary-top">

                    <span>
                        Cash Payments
                    </span>

                    <div class="payments-summary-icon summary-green">
                        <i class="bi bi-cash"></i>
                    </div>

                </div>

                <strong class="payments-summary-value">
                    @cashPayments
                </strong>

                <span class="payments-summary-description">
                    Cash transactions
                </span>

            </div>

        </div>


        <!-- Card Payments -->
        <div class="col-md-6 col-xl-3">

            <div class="payments-summary-card">

                <div class="payments-summary-top">

                    <span>
                        Card Payments
                    </span>

                    <div class="payments-summary-icon summary-blue">
                        <i class="bi bi-credit-card"></i>
                    </div>

                </div>

                <strong class="payments-summary-value">
                    @cardPayments
                </strong>

                <span class="payments-summary-description">
                    Card transactions
                </span>

            </div>

        </div>


        <!-- Online Payments -->
        <div class="col-md-6 col-xl-3">

            <div class="payments-summary-card">

                <div class="payments-summary-top">

                    <span>
                        Online Payments
                    </span>

                    <div class="payments-summary-icon summary-purple">
                        <i class="bi bi-globe2"></i>
                    </div>

                </div>

                <strong class="payments-summary-value">
                    @onlinePayments
                </strong>

                <span class="payments-summary-description">
                    Online transactions
                </span>

            </div>

        </div>

    </div>


    <!-- Payments Table -->
    <div class="payments-report-table-card">

        <div class="payments-report-table-header">

            <div class="payments-report-table-title">

                <div class="payments-report-table-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>

                    <span class="payments-report-table-label">
                        TRANSACTION HISTORY
                    </span>

                    <h2>
                        All Payments
                    </h2>

                    <p>
                        Detailed record of all hotel payment transactions.
                    </p>

                </div>

            </div>

            <div class="payments-report-count">
                @Model.Count
                <span>Payments</span>
            </div>

        </div>


        @if (Model.Count == 0)
        {
            <div class="payments-report-empty">

                <div class="payments-report-empty-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>

                <h3>
                    No Payments Found
                </h3>

                <p>
                    There are currently no payment transactions
                    available in the system.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="payments-report-table">

                    <thead>

                        <tr>
                            <th>Payment ID</th>
                            <th>Reservation</th>
                            <th>Guest</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Payment Date</th>
                            <th>Recorded By</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var payment in Model)
                        {
                            <tr>

                                <td>

                                    <span class="report-payment-id">
                                        #@payment.Id
                                    </span>

                                </td>


                                <td>

                                    <span class="report-reservation-id">
                                        #@payment.ReservationId
                                    </span>

                                </td>


                                <td>

                                    <div class="report-guest-cell">

                                        <div class="report-guest-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <span>
                                            @payment.Reservation
                                            .Guest.User.FullName
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <strong class="report-amount-value">
                                        @payment.Amount.ToString("N2") EGP
                                    </strong>

                                </td>


                                <td>

                                    <span class="report-method-badge method-@payment.Method">

                                        @if (payment.Method == PaymentMethod.Cash)
                                        {
                                            <i class="bi bi-cash"></i>
                                        }
                                        else if (payment.Method == PaymentMethod.Card)
                                        {
                                            <i class="bi bi-credit-card"></i>
                                        }
                                        else if (payment.Method == PaymentMethod.Online)
                                        {
                                            <i class="bi bi-globe2"></i>
                                        }

                                        @payment.Method

                                    </span>

                                </td>


                                <td>

                                    <div class="report-payment-date">

                                        <i class="bi bi-clock"></i>

                                        <span>
                                            @payment.PaidAt
                                            .ToString("dd MMM yyyy, hh:mm tt")
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    @if (payment.RecordedByUser != null)
                                    {
                                        <div class="report-recorded-user">

                                            <div class="report-user-icon">
                                                <i class="bi bi-person-check"></i>
                                            </div>

                                            <span>
                                                @payment.RecordedByUser.FullName
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="report-online-payment-user">

                                            <i class="bi bi-globe2"></i>

                                            Guest Online Payment

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>