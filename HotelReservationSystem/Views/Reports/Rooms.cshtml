@model List<HotelReservationSystem.Models.Entities.Room>

@using HotelReservationSystem.Models

@{
    ViewData["Title"] = "Rooms Report";

    int totalRooms = Model.Count;

    int availableRooms =
        Model.Count(room =>
            room.Status == RoomStatus.Available);

    int occupiedRooms =
        Model.Count(room =>
            room.Status == RoomStatus.Occupied);

    int maintenanceRooms =
        Model.Count(room =>
            room.Status == RoomStatus.Maintenance);
}

<div class="rooms-report-page">

    <!-- Report Header -->
    <div class="rooms-report-header">

        <div class="rooms-report-heading">

            <span class="rooms-report-label">
                HOTEL ANALYTICS
            </span>

            <h1>
                Rooms Report
            </h1>

            <p>
                Monitor room availability, occupancy and
                maintenance status across the hotel.
            </p>

        </div>


        <div class="rooms-report-header-actions">

            <div class="rooms-report-icon">
                <i class="bi bi-door-open"></i>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="rooms-report-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>

    </div>


    <!-- Room Summary -->
    <div class="row g-4 rooms-report-summary">

        <!-- Total Rooms -->
        <div class="col-md-6 col-xl-3">

            <div class="rooms-summary-card">

                <div class="rooms-summary-top">

                    <span>
                        Total Rooms
                    </span>

                    <div class="rooms-summary-icon rooms-blue">
                        <i class="bi bi-building"></i>
                    </div>

                </div>

                <strong class="rooms-summary-value">
                    @totalRooms
                </strong>

                <span class="rooms-summary-description">
                    Registered hotel rooms
                </span>

            </div>

        </div>


        <!-- Available -->
        <div class="col-md-6 col-xl-3">

            <div class="rooms-summary-card">

                <div class="rooms-summary-top">

                    <span>
                        Available Rooms
                    </span>

                    <div class="rooms-summary-icon rooms-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

                <strong class="rooms-summary-value">
                    @availableRooms
                </strong>

                <span class="rooms-summary-description">
                    Ready for guests
                </span>

            </div>

        </div>


        <!-- Occupied -->
        <div class="col-md-6 col-xl-3">

            <div class="rooms-summary-card">

                <div class="rooms-summary-top">

                    <span>
                        Occupied Rooms
                    </span>

                    <div class="rooms-summary-icon rooms-red">
                        <i class="bi bi-person-fill"></i>
                    </div>

                </div>

                <strong class="rooms-summary-value">
                    @occupiedRooms
                </strong>

                <span class="rooms-summary-description">
                    Currently occupied
                </span>

            </div>

        </div>


        <!-- Maintenance -->
        <div class="col-md-6 col-xl-3">

            <div class="rooms-summary-card">

                <div class="rooms-summary-top">

                    <span>
                        Maintenance
                    </span>

                    <div class="rooms-summary-icon rooms-orange">
                        <i class="bi bi-tools"></i>
                    </div>

                </div>

                <strong class="rooms-summary-value">
                    @maintenanceRooms
                </strong>

                <span class="rooms-summary-description">
                    Rooms under maintenance
                </span>

            </div>

        </div>

    </div>


    <!-- Rooms Table -->
    <div class="rooms-report-table-card">

        <div class="rooms-report-table-header">

            <div class="rooms-report-table-title">

                <div class="rooms-report-table-icon">
                    <i class="bi bi-grid-1x2"></i>
                </div>

                <div>

                    <span class="rooms-table-label">
                        ROOM INVENTORY
                    </span>

                    <h2>
                        All Hotel Rooms
                    </h2>

                    <p>
                        Detailed overview of every room and its current status.
                    </p>

                </div>

            </div>


            <div class="rooms-report-count">

                @Model.Count

                <span>
                    Rooms
                </span>

            </div>

        </div>


        @if (Model.Count == 0)
        {
            <div class="rooms-report-empty">

                <div class="rooms-report-empty-icon">
                    <i class="bi bi-door-closed"></i>
                </div>

                <h3>
                    No Rooms Found
                </h3>

                <p>
                    There are currently no rooms available
                    in the system.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="rooms-report-table">

                    <thead>

                        <tr>
                            <th>Room Number</th>
                            <th>Floor</th>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Price Per Night</th>
                            <th>Status</th>
                            <th>Created By</th>
                            <th>Last Modified By</th>
                            <th>Last Modified At</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var room in Model)
                        {
                            <tr>

                                <!-- Room Number -->
                                <td>

                                    <span class="rooms-report-number">
                                        <i class="bi bi-door-open"></i>
                                        @room.RoomNumber
                                    </span>

                                </td>


                                <!-- Floor -->
                                <td>

                                    <span class="rooms-report-floor">
                                        <i class="bi bi-layers"></i>
                                        @room.FloorNumber
                                    </span>

                                </td>


                                <!-- Room Type -->
                                <td>

                                    <strong class="rooms-report-type">
                                        @room.RoomType.Name
                                    </strong>

                                </td>


                                <!-- Capacity -->
                                <td>

                                    <span class="rooms-report-capacity">

                                        <i class="bi bi-people"></i>

                                        @room.RoomType.Capacity Guests

                                    </span>

                                </td>


                                <!-- Price -->
                                <td>

                                    <strong class="rooms-report-price">
                                        @room.RoomType.BasePricePerNight
                                        .ToString("N2")
                                        EGP
                                    </strong>

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="rooms-status-badge status-@room.Status">

                                        @if (room.Status == RoomStatus.Available)
                                        {
                                            <i class="bi bi-check-circle"></i>
                                        }
                                        else if (room.Status == RoomStatus.Occupied)
                                        {
                                            <i class="bi bi-person-fill"></i>
                                        }
                                        else if (room.Status == RoomStatus.Maintenance)
                                        {
                                            <i class="bi bi-tools"></i>
                                        }

                                        @room.Status

                                    </span>

                                </td>


                                <!-- Created By -->
                                <td>

                                    <div class="rooms-user-cell">

                                        <div class="rooms-user-icon">
                                            <i class="bi bi-person-plus"></i>
                                        </div>

                                        <span>
                                            @room.CreatedByUser.FullName
                                        </span>

                                    </div>

                                </td>


                                <!-- Last Modified By -->
                                <td>

                                    @if (room.LastModifiedByUser != null)
                                    {
                                        <div class="rooms-user-cell">

                                            <div class="rooms-user-icon">
                                                <i class="bi bi-person-gear"></i>
                                            </div>

                                            <span>
                                                @room.LastModifiedByUser.FullName
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="rooms-not-modified">
                                            Not modified
                                        </span>
                                    }

                                </td>


                                <!-- Last Modified At -->
                                <td>

                                    @if (room.LastModifiedAt.HasValue)
                                    {
                                        <div class="rooms-modified-date">

                                            <i class="bi bi-clock"></i>

                                            <span>
                                                @room.LastModifiedAt.Value
                                                .ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="rooms-not-modified">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>